{
  "name": "nextjs-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve@latest out -l 3000",
    "lint": "eslint",
    "build:cpanel": "next build && chmod -R u=rwX,go=rX out && rm -f cpanel-upload.zip && (cd out && zip -r -X ../cpanel-upload.zip . -x '*.DS_Store')"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.6"
  }
}
